rules_version = '2';

// MeowLife Firestore Security Rules. Paste into Firebase console → Firestore → Rules → Publish.
// Tested against the emulator: `npm run test:rules` (rules-test/). The in-app "ทดสอบการเชื่อมต่อ" button checks they are live.
//
// Relaxed on purpose (v0.4.1): publish ONCE, and new kinds of data (new collections) work without touching the rules again.
//   1) Only the owner (request.auth.uid == {uid}) can touch users/{uid}/... — nobody else, not even signed-in users.
//   2) Any collection under the owner's own space is allowed, as long as each document carries its own id
//      (matching the path) and a text updatedAt, and has a sane number of fields.
// The app itself still validates every field with zod before saving locally; this is a personal, single-owner database.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function wellFormed(d, docId) {
      return d.id == docId
        && d.updatedAt is string && d.updatedAt.size() >= 20 && d.updatedAt.size() <= 40
        && d.keys().size() <= 40;
    }

    match /users/{uid}/{collection}/{docId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && wellFormed(request.resource.data, docId);
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
