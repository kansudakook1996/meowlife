# Dependencies & build output
node_modules/
out/
dist/
coverage/
test-results/
playwright-report/
*.tsbuildinfo

# Secrets — never commit (.env holds only the public Firebase web config and IS committed)
.env.local
.env.*.local
*.pem
*.p12
*.pfx
serviceAccount*.json
*-firebase-adminsdk-*.json

# Local data — never commit real financial data
*.db
*.db-wal
*.db-shm
*.sqlite
backups/
*.meowbackup

# Firebase emulator / debug
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log

# OS / editor
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/
*.log

# Private design reference images (may be third-party artwork) - keep local only
picture ref/

# Locally licensed fonts (e.g. demo fonts) must never be committed or bundled
*.zip
*.ttf
*.otf
fonts-local/

# Temporary manual tests against the installed app
e2e/zz-*
