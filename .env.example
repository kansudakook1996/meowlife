# Copy this file to .env.local and fill in your Firebase *web app* config (M4).
# .env.local is git-ignored. Never put service-account / Admin SDK keys here.
# These web config values are not secrets (they are embedded in the app);
# your data is protected by Firebase Auth + firestore.rules.
MAIN_VITE_FIREBASE_API_KEY=
MAIN_VITE_FIREBASE_AUTH_DOMAIN=
MAIN_VITE_FIREBASE_PROJECT_ID=
MAIN_VITE_FIREBASE_STORAGE_BUCKET=
MAIN_VITE_FIREBASE_MESSAGING_SENDER_ID=
MAIN_VITE_FIREBASE_APP_ID=
